PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/jewelleryshop
JWT_SECRET=your-jwt-secret-key

# Frontend configuration
FRONTEND_URL=http://localhost:3000
FRONTEND_ADMIN_URL=http://localhost:5173/admin

# Backend URL (used for generating absolute URLs, e.g. Google Drive callback)
BACKEND_URL=http://localhost:5000

# Google Drive OAuth 2.0
# Set these in the production environment
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google-drive/callback
GOOGLE_DRIVE_FOLDER_ID=

# Obtained via the OAuth flow at /api/auth/google-drive
GOOGLE_DRIVE_REFRESH_TOKEN=

# Optional — alternative encryption key for Google Drive tokens
# If unset, falls back to JWT_SECRET or GOOGLE_CLIENT_SECRET
GOOGLE_TOKEN_ENCRYPTION_KEY=

# SMTP (for email features)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_SECURE=false
MAIL_FROM=hello@yourstore.com
